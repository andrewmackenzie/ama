<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Microphone capture for dictation. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!--
	  App Sandbox is intentionally OFF: Ama needs a global CGEventTap
	  (Accessibility) to read the push-to-talk key and to inject text into other
	  apps, which the sandbox forbids. Hardened Runtime (enabled at signing) is
	  what notarization requires, not the sandbox.
	-->
</dict>
</plist>
